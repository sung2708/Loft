# Copy to deploy/prometheus/.env before starting the Prometheus agent.
# These values belong to the collector, never to the Go API or frontend.
MINGLY_METRICS_TARGET=mingly-api:8080
APP_ENV=production
BETTER_STACK_INGESTING_HOST=your-ingesting-host.betterstackdata.com
BETTER_STACK_METRICS_SOURCE_TOKEN=your-prometheus-source-token