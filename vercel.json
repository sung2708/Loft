{
  "rewrites": [
    {
      "source": "/",
      "destination": "/admin",
      "has": [
        {
          "type": "host",
          "value": "admin.mingly.site"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://mingly.site/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "www.mingly.site"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "https://mingly.site/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "loft-amber.vercel.app"
        }
      ]
    }
  ]
}
