APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Comma-separated Supabase user UUIDs allowed to access /admin.
ADMIN_USER_IDS=
GUEST_TOKEN_SECRET=replace-with-at-least-32-random-characters
# Optional; enables the protected Prometheus /metrics endpoint. Use a separate 32+ character secret.
METRICS_BEARER_TOKEN=3cd13168d449c41355713ec55ec6a43f1871a01db7cb26e38c1ce09fb6249321
# Optional in single-instance development. Required when multiple API instances serve rooms.
REDIS_URL=redis://localhost:6379/0
INSTANCE_ID=loft-local-1
# Optional YouTube Data API integration. Keep the key server-side only.
YOUTUBE_ENABLED=true
YOUTUBE_API_KEY=
